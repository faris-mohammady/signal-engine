# Copy to .env and fill in what you have. Everything is optional:
# with no keys, use `signal-engine run --pack job-search --offline`.

# LLM (one of these). Without a key, the classifier falls back to keyword matching.
ANTHROPIC_API_KEY=
SE_ANTHROPIC_MODEL=claude-haiku-5-5
OPENAI_API_KEY=
SE_OPENAI_MODEL=gpt-4o-mini

# Web fetching. Without a key, pages are fetched with plain HTTP (less reliable).
FIRECRAWL_API_KEY=
# Change only if you self-host Firecrawl
FIRECRAWL_API_URL=https://api.firecrawl.dev

# Slack incoming webhook for the weekly brief (optional)
SLACK_WEBHOOK_URL=

# Database (SQLite file by default)
SE_DATABASE_URL=sqlite:///signal_engine.db
